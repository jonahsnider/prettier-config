{
	"name": "@jonahsnider/prettier-config",
	"version": "2.0.2",
	"keywords": [
		"xo",
		"prettier",
		"prettier-config"
	],
	"bugs": {
		"url": "https://github.com/jonahsnider/prettier-config/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonahsnider/prettier-config.git"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonahsnider.com",
		"url": "https://jonahsnider.com"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "zshy",
		"lint": "oxlint",
		"style": "prettier --check ."
	},
	"dependencies": {
		"prettier-config-xo": "3.0.0"
	},
	"devDependencies": {
		"oxlint": "1.81.0",
		"prettier": "3.9.6",
		"typescript": "6.0.3",
		"zshy": "0.7.3"
	},
	"packageManager": "pnpm@12.3.1",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "warn"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"zshy": {
		"exports": "./src/index.ts",
		"cjs": false
	},
	"peerDependencies": {
		"prettier": "^3.0.0"
	}
}
